{
  "expo": {
    "name": "Attendify",
    "slug": "ProeximaAI_Attendance_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "proeximaaiattendanceapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow ProeximaAI to access your camera for facial recognition punch-in.",
        "NSLocationWhenInUseUsageDescription": "Allow ProeximaAI to access your location to verify your punch-in coordinates.",
        "NSPhotoLibraryUsageDescription": "Allow ProeximaAI to access your photos to upload profile pictures and KYC documents."
      }
    },
    "android": {
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.attendify.proeximaai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ProeximaAI to access your camera for facial recognition punch-in.",
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ff1b8ca-0ac6-48e8-91c0-8ec7c731f166"
      }
    },
    "owner": "proeximaai"
  }
}